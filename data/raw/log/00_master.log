. *add variables from the Responding households dataset
. foreach w of global UKHLS_panel_waves {
  2. 
.         // find the wave number
.         local waveno=strpos("abcdefghijklmnopqrstuvwxyz","`w'")
  3. 
.         if (`waveno'==1) {
  4.                 use `w'_hidp `w'_fihhmnnet1_dv `w'_fihhmngrs1_dv `w'_fihhmnsben_dv `w'_nch02_dv /*`w'_hhdenub_xw `w'_hhdenui_xw*/
>  `w'_hsownd using `w'_hhresp.dta, clear
  5.         }
  6.         else if (`waveno'<6) {
  7.                 use `w'_hidp `w'_fihhmnnet1_dv `w'_fihhmngrs1_dv `w'_fihhmnsben_dv `w'_nch02_dv `w'_hhdenub_xw /*`w'_hhdenui_xw*/
