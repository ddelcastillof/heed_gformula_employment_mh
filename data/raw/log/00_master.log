. /**************************************************************************************
> * ROUTE TO WORKER FILES 
> **************************************************************************************/
. * process UKHLS data
. do "${dir_do}/01_merge.do"

. ***************************************************************************************
. * PROJECT:              Health Equity and its Economic Determinants
. * DO-FILE NAME:         01_merge.do
. * DESCRIPTION:          Merges individual and household response files
. ***************************************************************************************
. * COUNTRY:              UK
. * DATA:                     UKHLS EUL version - UKDA-6614-stata [to wave o]
. * AUTHORS:                              Darwin del Castillo
. * LAST UPDATE:          17 Mar 2026
. ***************************************************************************************
. /*
> * This do-file merges the individual and household response files by:
> 1. Selecting relevant variables from each file and renaming them to have a consistent wave prefix (w1_, w2_, etc.)
> 2. Appending the selected variables across waves to create combined datasets for individual and household responses
> 3. Merging the combined individual and household datasets together using the unique identifiers (pidp, hidp, swv) to create a final 
> merged dataset with all relevant variables for analysis
> */
. 
. cd "${dir_ukhls_data}"
/Users/darwin.delcastillofernandez/Documents/GitHub/heed_gformula_employment_mh/.worktrees/fix-import-data/data/raw/ukhls

. 
. /**************************************************************************************
> * Select and merge UKHLS data 
> *************************************************************************************/
. 
. *add variables from the all persons (Household grid) dataset
. foreach w of global UKHLS_panel_waves {
  2. 
.         // find the wave number
.         local waveno=strpos("abcdefghijklmnopqrstuvwxyz","`w'")
  3.         
.         if (`waveno'<13) {
  4.                 use pidp `w'_ivfho `w'_ivfio `w'_hhorig `w'_memorig `w'_buno_dv `w'_dvage `w'_sex `w'_depchl `w'_hidp `w'_pno `w'
> _pns1pid `w'_pns2pid `w'_month `w'_intdaty_dv ///
>                 `w'_mnspid `w'_fnspid `w'_ppid `w'_ppno `w'_sppid `w'_sex_dv `w'_mastat_dv `w'_gor_dv `w'_age_dv  /* `w'_hgbioad1 `w
> '_hgbioad2 */ ///
>                 `w'_intdatd_dv `w'_intdatm_dv `w'_intdaty_dv `w'_ethn_dv using `w'_indall.dta, clear
  5.         }
  6.         else {
  7.                 use pidp `w'_ivfho `w'_ivfio `w'_hhorig `w'_memorig `w'_buno_dv `w'_dvage `w'_sex `w'_depchl `w'_hidp `w'_pno `w'
> _pns1pid `w'_pns2pid `w'_month `w'_intdaty_dv ///
>                 `w'_mnspid `w'_fnspid `w'_ppid `w'_ppno `w'_sppid `w'_sex_dv `w'_mastat_dv `w'_gor_dv `w'_age_dv  `w'_hgbioad1 `w'_h
> gbioad2 ///
>                 `w'_intdatd_dv `w'_intdatm_dv `w'_intdaty_dv `w'_ethn_dv using `w'_indall.dta, clear
  8.         }
  9. 
.         gen swv = `waveno'
 10.         rename `w'_* *
 11.         if (`waveno'>1) {
 12.                 append using "$dir_out/add_vars_ukhls.dta"
 13.         }
 14.         save "$dir_out/add_vars_ukhls.dta", replace
 15. }
