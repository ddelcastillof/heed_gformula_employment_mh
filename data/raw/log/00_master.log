  8.         }
  9.         else if (`waveno'<=14) {
 10.                 use `w'_hidp `w'_fihhmnnet1_dv `w'_fihhmngrs1_dv `w'_fihhmnsben_dv `w'_nch02_dv /*`w'_hhdenub_xw*/ `w'_hhdenui_xw
>  `w'_hsownd using `w'_hhresp.dta, clear
 11.         } 
 12.         else if (`waveno'>=15) {
 13.                 use `w'_hidp `w'_fihhmnnet1_dv `w'_fihhmngrs1_dv `w'_fihhmnsben_dv `w'_nch02_dv /*`w'_hhdenub_xw `w'_hhdenui_xw*/
>  `w'_hhdeng2_xw `w'_hsownd using `w'_hhresp.dta, clear
 14.         }
